{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vsunilkumar.github.io/MyLearningCommandCenter/schemas/roadmap.schema.json",
  "title": "My Learning Command Center Roadmap",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "technologyId",
    "technologyName",
    "roadmapVersion",
    "description",
    "prerequisites",
    "modules"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.0"
    },
    "technologyId": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "technologyName": {
      "type": "string",
      "minLength": 2
    },
    "roadmapVersion": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "prerequisites": {
      "type": "array",
      "items": { "type": "string" }
    },
    "modules": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id", "sequence", "title", "description", "topics"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          },
          "sequence": {
            "type": "integer",
            "minimum": 1
          },
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "topics": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id", "sequence", "title", "objectives"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-z0-9-]+$"
                },
                "sequence": {
                  "type": "integer",
                  "minimum": 1
                },
                "title": {
                  "type": "string"
                },
                "objectives": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "id", "sequence", "title",
                      "description", "level", "estimatedMinutes",
                      "tags", "prerequisites"
                    ],
                    "properties": {
                      "id": {
                        "type": "string",
                        "pattern": "^[a-z0-9-]+$"
                      },
                      "sequence": {
                        "type": "integer",
                        "minimum": 1
                      },
                      "title": {
                        "type": "string"
                      },
                      "description": {
                        "type": "string"
                      },
                      "level": {
                        "type": "string",
                        "enum": [
                          "foundation",
                          "intermediate",
                          "advanced",
                          "expert"
                        ]
                      },
                      "estimatedMinutes": {
                        "type": "integer",
                        "minimum": 1
                      },
                      "tags": {
                        "type": "array",
                        "items": { "type": "string" }
                      },
                      "prerequisites": {
                        "type": "array",
                        "items": { "type": "string" }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
